# ──────────────────────────────────────────────────────────────────
# IntelliPlan — environment template
# Copy this to `.env` (gitignored) and fill in the real values.
# Production deployments (Railway, Render, etc.) should set these as
# dashboard environment variables, not commit them.
# ──────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=https://intelliplan.tech
DATABASE_URL=sqlite:///intelliplan.db
PORT=3000

# ── Admin allow-list ────────────────────────────────────────────
# Comma-separated list of emails that can access /admin-x9k2p7
ADMIN_EMAILS=uanirudh0811@gmail.com
ADMIN_PATH=/admin-x9k2p7

# ── AI (Google Gemini primary, Groq fallback) ───────────────────
# Get a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional metadata — your Google Cloud project number (not required for API key auth)
# GEMINI_PROJECT_ID=553214960905
# Strongly recommended, not optional in practice: the Gemini free tier allows
# 20 requests a day on gemini-2.5-flash, and when that runs out with no Groq
# key set every AI feature in the product stops. Free key, no card:
# https://console.groq.com/keys
GROQ_API_KEY=
# Paid-plan model. Claude is only ever reached by accounts on the paid plan;
# leaving this unset drops it out of the chain entirely.
ANTHROPIC_API_KEY=
# Comma-separated emails that get the paid model before billing exists.
PAID_USER_EMAILS=
# Groq keys per capability. Speech and image reading run on their own keys so
# a voice conversation cannot exhaust the key the tutor's text answers need.
# Both fall back to GROQ_API_KEY when unset.
GROQ_AUDIO_KEY=
GROQ_VISUAL_API_KEY=
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Groq TTS is only a fallback now; Fish Audio reads replies aloud.
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=tara

# ── Read-aloud voice (Fish Audio) ───────────────────────────────
# https://fish.audio -> API keys. The four voices Plani offers are all
# AI-designed rather than cloned from a real person.
FISH_AUDIO_KEY=
# FISH_AUDIO_MODEL=s2.1-pro-free
# Default voice id (Ethan). Students pick their own in the tutor sidebar.
# FISH_AUDIO_VOICE=536d3a5e000945adb7038665781a4aca

# ── Media generation (Pollinations) ─────────────────────────────
# Secret sk_ key, server-side only: https://enter.pollinations.ai/keys
# A publishable pk_ key in page code would let anyone spend the balance.
POLLINATIONS_API_KEY=
# POLLINATIONS_IMAGE_MODEL=flux
# POLLINATIONS_VIDEO_MODEL=seedance-2.0-fast
# POLLINATIONS_3D_MODEL=trellis-2

# ── AI firewall (ai_firewall.py) ────────────────────────────────
# Counters live in the database, so these are per account (or per signed
# device cookie for guests) and survive deploys and multiple instances.
# Requests per hour / per day, estimated tokens per day, and the ceiling the
# server clamps a caller's requested max_tokens to.
# AI_GUEST_RPH=4
# AI_GUEST_RPD=8
# AI_GUEST_TPD=12000
# AI_GUEST_MAX_OUTPUT=1200
# AI_FREE_RPH=15
# AI_FREE_RPD=40
# AI_FREE_TPD=60000
# AI_FREE_MAX_OUTPUT=2600
# AI_PAID_RPH=120
# AI_PAID_RPD=600
# AI_PAID_TPD=1500000
# AI_PAID_MAX_OUTPUT=4000
# Set to 1 to switch every AI feature off without a deploy.
# AI_KILL_SWITCH=

# ── Google OAuth + Calendar ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://intelliplan.tech/oauth2callback

# ── Notion OAuth (public connection) ────────────────────────────
# Create a PUBLIC connection at https://app.notion.com/developers/connections
# and register the redirect URI below under its OAuth configuration. It must
# match byte-for-byte — Notion rejects the token exchange otherwise.
#
# Add a second redirect URI for local work if you need it, e.g.
#   http://localhost:5000/oauth/notion/callback
# and set NOTION_REDIRECT_URI to whichever one this deployment serves.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://intelliplan.tech/oauth/notion/callback
# Version header for the OAuth token endpoints only. The data plane is
# versioned separately by the notion-client SDK; do not assume changing this
# changes how databases and pages are read.
# NOTION_API_VERSION=2026-03-11

# ── Canvas OAuth (Developer Key) ────────────────────────────────
# Canvas has no global OAuth provider — each Canvas instance issues its
# own Developer Keys. To make "Continue with Canvas" work for students on
# the public free Canvas (canvas.instructure.com), register a Developer
# Key there:
#   1. Visit https://canvas.instructure.com (sign in as a teacher account)
#   2. Admin -> Developer Keys -> +Developer Key -> +API Key
#   3. Key Name: IntelliPlan
#   4. Redirect URIs: https://intelliplan.tech/oauth/canvas/callback
#   5. Scopes: leave unscoped (or pick url:GET|/api/v1/courses,
#      url:GET|/api/v1/courses/:course_id/assignments,
#      url:GET|/api/v1/users/:user_id/enrollments)
#   6. Save, then flip the key to "ON" in the Developer Keys list.
#   7. Copy the "ID" -> CANVAS_CLIENT_ID, "Key" -> CANVAS_CLIENT_SECRET.
# For self-hosted school Canvas instances, ask the school's Canvas admin
# to register the same key and add an override env var, e.g.:
#   CANVAS_CLIENT_ID_CANVAS_SCHOOL_EDU=...
#   CANVAS_CLIENT_SECRET_CANVAS_SCHOOL_EDU=...
# (Replace dots/dashes in the host with underscores and uppercase it.)
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=https://intelliplan.tech/oauth/canvas/callback
CANVAS_DEFAULT_BASE=https://canvas.instructure.com

# Google Classroom OAuth (separate from Google Calendar)
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=

# Blackboard Learn OAuth (three-legged / 3LO)
# Register IntelliPlan in the Anthology/Blackboard developer portal, then have
# each institution enable the REST app on its Learn instance. Users enter their
# institution URL in /connect.
# Leave these blank and /connect shows the coming-soon state plus the
# manual-classes fallback rather than starting a flow that cannot finish.
#
# IMPORTANT — the developer portal shows THREE values, and they are not
# interchangeable:
#   Application ID  a UUID the *school's* admin registers. -> BLACKBOARD_APPLICATION_ID
#   Application Key a UUID sent as OAuth client_id.        -> BLACKBOARD_APP_KEY
#   Secret          the matching secret.                   -> BLACKBOARD_APP_SECRET
# The Application ID is ALSO shown as the "Client ID" for LTI 1.3 — same value,
# two names. It is still not a valid REST client_id: putting it in the key slot
# makes Blackboard answer the authorization endpoint with
# {"code":"illegalArgument","message":"invalid client_id"} *after* the student
# has already signed in.
# BLACKBOARD_CLIENT_ID / BLACKBOARD_CLIENT_SECRET are accepted as legacy
# aliases for the key/secret pair. If BLACKBOARD_CLIENT_ID holds the LTI Client
# ID (i.e. the Application ID), set BLACKBOARD_APP_KEY too — it takes priority.
#
# Run `python scripts/blackboard_doctor.py` to check this configuration. It
# prints no secret values, only which vars are set and which ones conflict.
BLACKBOARD_APP_KEY=
BLACKBOARD_APP_SECRET=
# The Application ID the school's Blackboard administrator must add under
# System Admin -> Integrations -> REST API Integrations, with End User Access
# set to Yes. /connect shows this value to students whose school has not
# approved the integration yet, so they can hand it to their admin.
BLACKBOARD_APPLICATION_ID=
# Scopes. `offline` is required — without it Blackboard issues no refresh
# token and every connection dies at the first expiry (about an hour).
BLACKBOARD_SCOPE=read offline
# Must match the developer-portal registration byte-for-byte. This value wins
# over APP_BASE_URL, so a staging host or a www/apex mismatch cannot silently
# produce invalid_redirect_uri at the token exchange.
BLACKBOARD_REDIRECT_URI=https://intelliplan.tech/api/lms/callback/blackboard
# LTI 1.3 registration values (BLACKBOARD_ISSUER,
# BLACKBOARD_OIDC_AUTH_REQUEST_ENDPOINT, BLACKBOARD_AUTH_TOKEN_ENDPOINT) are
# NOT read by IntelliPlan — it connects over the REST API, not LTI. A school
# that registers only the LTI tool still rejects sign-in with
# "invalid client_id"; they must also add the Application ID under
# System Admin -> Integrations -> REST API Integrations.

# Moodle web services
# Moodle is enabled by default. Set MOODLE_ENABLED=0 to hide it while an
# institution is not ready to issue web-service tokens.
MOODLE_ENABLED=1

# IndexNow
# This key is served at https://intelliplan.tech/<INDEXNOW_KEY>.txt and used
# to notify participating search engines when public URLs change.
INDEXNOW_KEY=15d38c49db0d48efa4ec2ad2635b43c9
INDEXNOW_KEY_LOCATION=https://intelliplan.tech/15d38c49db0d48efa4ec2ad2635b43c9.txt
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# ── Email — Resend (preferred) ──────────────────────────────────
# Create an API key at https://resend.com/api-keys
# Then verify the sending domain (intelliplan.tech) at
# https://resend.com/domains. RESEND_FROM must use a verified domain.
RESEND_API_KEY=
RESEND_FROM=IntelliPlan <noreply@intelliplan.tech>

# ── Email — SMTP fallback (optional) ────────────────────────────
# Used only if RESEND_API_KEY is not set. For Gmail, create an App
# Password at https://myaccount.google.com/apppasswords and paste it
# below (spaces are stripped automatically).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── SMS delivery ────────────────────────────────────────────────
# IntelliPlan does NOT use a third-party SMS API. Texts are delivered
# by emailing the recipient's carrier gateway address (e.g.
# 5551234567@tmomail.net for T-Mobile). The user picks their carrier
# in Settings. Whichever email path is configured above (Resend or
# SMTP) is reused to deliver the SMS — no extra config needed.

# ── Sentry (error monitoring, optional) ─────────────────────────
SENTRY_DSN=

# ── Web Push (VAPID) ────────────────────────────────────────────
# Required for browser and desktop push notifications. Generate ONCE:
#
#     python vapid.py
#
# and paste the three lines it prints here (and into your host's
# environment variables in production).
#
# Rotating VAPID_PRIVATE_KEY invalidates EVERY existing browser
# subscription — every student would have to re-enable notifications — so
# generate this once and keep it. Treat the private key like a password:
# it is what proves a push came from you.
#
# VAPID_EMAIL must be an address a push service can actually reach you at.
# It is sent as the 'sub' claim and some services reject pushes without it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ── Notification delivery (cron) ────────────────────────────────
# The outbox is drained by POST/GET /cron/notifications, which both sweeps
# for new events and delivers what is due. Point a scheduler at it every
# 5 minutes. It is safe to call more often than needed: the sweep
# deduplicates on a UNIQUE constraint and delivery claims rows before
# sending, so overlapping runs cannot double-send.
#
#   bash / macOS / Linux:
#     curl -X POST https://your-domain/cron/notifications \
#          -H "X-Cron-Token: $CRON_SECRET"
#
#   PowerShell — note curl.exe, not curl. In PowerShell `curl` is an alias
#   for Invoke-WebRequest, whose -Headers takes a hashtable, so the line
#   above fails with a parameter-binding error rather than doing anything:
#     curl.exe -X POST https://your-domain/cron/notifications `
#              -H "X-Cron-Token: $env:CRON_SECRET"
#
# A 401 means the secret is missing or wrong; the JSON body says which.
# A 503 means CRON_SECRET is unset here. Both are the endpoint working.
#
# Without this set the endpoint returns 503 and nothing is ever delivered.
#
# CRON_SECRET also guards /cron/send-reminders and /cron/lifecycle-emails.
# Every cron endpoint accepts either header name, X-Cron-Secret or
# X-Cron-Token, plus ?secret= as a fallback. They used to differ per
# endpoint; using the wrong one returned an auth error that pointed at the
# secret rather than the header, so both are accepted everywhere now.
CRON_SECRET=

# ── Lifecycle email — postal address ────────────────────────────
# CAN-SPAM §7704(a)(5) requires a valid physical postal address in every
# commercial email. It is rendered in the footer of the newsletter and the
# feedback request.
#
# A PO box or a registered agent's address is fine; a home address is not
# required. What is required is that it exists — with this unset the
# newsletter and feedback sends REFUSE to run and log loudly, rather than
# quietly shipping a non-compliant email.
#
# The welcome email is transactional and sends without it.
#
#   MARKETING_POSTAL_ADDRESS=IntelliPlan, PO Box 1234, San Jose, CA 95101
MARKETING_POSTAL_ADDRESS=

# ── Lifecycle email — where replies go ──────────────────────────
# All three emails invite a reply ("hit reply and answer any of these"),
# but they are sent From a no-reply address. These two decide where a
# student's reply and support question actually land, and they are
# printed in the email body as mailto: links.
#
# IMPORTANT: point these at a mailbox that RECEIVES today. A send-only
# domain has no MX records, so an address on it silently bounces every
# reply. intelliplan.tech is currently in exactly that state — it sends
# (once Resend is verified) but cannot receive.
#
# Until the domain has MX records, use an inbox that already works:
#   MARKETING_REPLY_TO=youraddress@gmail.com
#
# SUPPORT_EMAIL falls back to MARKETING_REPLY_TO when unset.
# Run GET /api/admin/email/preflight to see which of these are wrong.
MARKETING_REPLY_TO=
SUPPORT_EMAIL=

# Analytics
# IntelliPlan loads NO third-party analytics script in the browser. Product
# usage is measured server-side via PostHog, which sets no browser cookie.
# Microsoft Clarity (session replay) was removed: the Privacy Policy promises
# schools we do not do session recording, and that promise is worth more than
# the heatmaps. Anything added in future must be declared in cookie_policy.py
# and gated on consent -- see tests/test_cookie_consent.py.

# ── Encryption at rest ──────────────────────────────────────────
# Encrypts the third-party OAuth tokens IntelliPlan stores (Canvas, Google,
# Notion, Blackboard, Moodle). Without it those are kept in plaintext, so a
# database backup or a snapshot hands over live access to every connected
# student account.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate by putting the new key first, comma separated: values are read with
# any listed key and always written with the first. Then re-run
# scripts/encrypt_existing_tokens.py.
# Losing this key is not recoverable — affected students must reconnect
# their accounts. Keep it in a secret store, never in git.
DATA_ENCRYPTION_KEY=

# ── reCAPTCHA (bot protection) ──────────────────────────────────
# Get keys at https://www.google.com/recaptcha/admin
# Both must be set or the check stays off entirely — a site key with no
# secret would reject every submission.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Which widget to render: v2 draws a checkbox, v3 is invisible and scored.
# This MUST match the type of key you registered, or the widget will not
# appear. Server-side verification handles either without a code change.
RECAPTCHA_VERSION=v2
# v3 only. Google's default is 0.5; below that, real students on shared or
# VPN'd connections start getting refused.
RECAPTCHA_SCORE_THRESHOLD=0.5
#
# Where it applies: registration and password reset always; sign-in only
# after a few failed attempts on that account, so honest students are not
# asked to tick a box every day. Verification fails OPEN if Google is
# unreachable — an outage there must not become an outage here.
