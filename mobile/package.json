{
  "name": "intelliplan-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:prod": "cross-env EXPO_PUBLIC_API_BASE=https://intelliplan.tech expo start",
    "start:tunnel": "cross-env EXPO_PUBLIC_API_BASE=https://intelliplan.tech expo start --tunnel",
