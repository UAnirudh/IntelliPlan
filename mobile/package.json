    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.0",
    "cross-env": "^10.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
