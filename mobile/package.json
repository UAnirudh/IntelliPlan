{
  "name": "intelliplan-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:prod": "cross-env EXPO_PUBLIC_API_BASE=https://intelliplan.tech expo start",
    "start:tunnel": "cross-env EXPO_PUBLIC_API_BASE=https://intelliplan.tech expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "release:preflight": "node scripts/android-release-preflight.mjs",
    "release:preflight:ios": "node scripts/ios-release-preflight.mjs",
    "audit:android-bundle": "node scripts/audit-android-bundle.mjs",
    "test:release-preflight": "node --test scripts/android-release-preflight.test.mjs scripts/ios-release-preflight.test.mjs scripts/audit-android-bundle.test.mjs scripts/audit-mobile-bundle-content.test.mjs",
    "test:reminder-mutation-sync": "node --test scripts/reminder-mutation-sync.test.mjs",
    "test:query-refresh": "node --test scripts/query-refresh.test.mjs",
    "test:navigation": "node --test scripts/mobile-navigation.test.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.26",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "zod": "4.6.7"
  }
}
