# Separate private deployment only; never put these on shared production.
SCHOOL_PILOT=1
SCHOOL_PILOT_COURSE_URL=https://lakesideschool.instructure.com/courses/4716
SCHOOL_PILOT_AI=off
SCHOOL_PILOT_GROQ_ZDR_CONFIRMED=0
SCHOOL_PILOT_CONTRACT_APPROVED=0

# Use a fresh isolated database, secret key and token-encryption key.
# Set values in your host's secret manager, never commit real credentials.
# DATABASE_URL=
# SECRET_KEY=
# DATA_ENCRYPTION_KEY=
# CANVAS_CLIENT_ID_LAKESIDESCHOOL_INSTRUCTURE_COM=
# CANVAS_CLIENT_SECRET_LAKESIDESCHOOL_INSTRUCTURE_COM=
# CANVAS_REDIRECT_URI=https://YOUR-PRIVATE-PILOT-HOST/oauth/canvas/callback

# Account- and user-level scopes are intentionally excluded.
CANVAS_SCOPES_LAKESIDESCHOOL_INSTRUCTURE_COM=url:GET|/api/v1/courses/:id url:GET|/api/v1/courses/:course_id/assignments url:GET|/api/v1/courses/:course_id/assignments/:id url:GET|/api/v1/courses/:course_id/assignment_groups url:GET|/api/v1/courses/:course_id/students/submissions

NOTIFICATIONS_INPROCESS_CRON=0
FOLLOWTHROUGH_INPROCESS_CRON=0
# Unset SENTRY_DSN, POSTHOG_API_KEY and all unused provider/integration keys.
# Groq is optional only after actual organization settings + contract approval:
# GROQ_API_KEY=
