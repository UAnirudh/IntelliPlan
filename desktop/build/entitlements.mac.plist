<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime is required for notarisation. Each exception below
       exists because a specific feature needs it; anything not listed stays
       denied, which is the point of the hardened runtime. -->

  <!-- Electron's renderer uses a JIT for JavaScript. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Reaching intelliplan.tech. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- The optional focus check-in on the Active page. Frames never leave
       the device; see static/js/ip-focus.js. -->
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
